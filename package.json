{
  "name": "gameedge",
  "version": "0.1.0",
  "private": true,
  "description": "GameEdge e-Sports Platform — Gaming Cafe Management System",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@gameedge/server",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@gameedge/server",
    "seed": "npm run seed --workspace=@gameedge/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
